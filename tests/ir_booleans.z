fn main() -> int {
   have flag: bool = true;
   have result = 0;

   if (flag) { result = result + 1; }          // 1
   if (5 == 5) { result = result + 2; }        // 3
   if (5 != 6) { result = result + 4; }        // 7
   if (3 < 5 && 5 <= 5) { result = result + 8; } // 15
   if (10 > 3 && 3 >= 3) { result = result + 16; } // 31

   return result;
}
